cmd_help() {
  show_command_menu
  cat <<EOF
DETAILS

  quest login YourName
  quest new YourName
      Create a new player OR switch to an existing one.
      Progress is saved per name and is never mixed.

  quest
      Show your current campaign lesson (asks for name if needed).

  quest <N>
  quest go <N>
      Jump to unlocked level N without undoing cleared progress.
      Example: quest 5   or   quest 17
      After clearing all 29, every level is unlocked.

  quest levels
      Show the full numbered level map.

  quest check
      Verify the lesson you are viewing and unlock the next one.
      Replaying an old level does NOT erase later clears.

  quest log <cmd>
      Manually save evidence. Example: quest log whoami

  quest who
      Show who is logged in.

  quest users
      List all players and their progress.

  quest logout
      Log out current player (next quest will ask for a name).

  quest reset
      Reset ONLY the current player's progress.

BEGINNER FLOW
  1) cd ~/quest-lab
  2) quest
  3) enter your name (or: quest login YourName)
  4) follow the lesson
  5) quest check
EOF
}

case "${1:-status}" in
  login|new|switch)
    shift
    show_command_menu
    if [[ $# -lt 1 ]]; then
      echo "Create or switch to a player:"
      echo "  quest login YourName"
      echo "  quest new YourName"
      echo
      echo "Examples:"
      echo "  quest login alex"
      echo "  quest login sara"
      echo
      if [[ -t 0 ]]; then
        ask_login_interactive
      else
        echo "This terminal is not interactive."
        echo "Run:  quest login YourName"
        exit 1
      fi
    else
      if ! login_user "$*"; then
        exit 1
      fi
    fi
    show_status
    ;;
  logout)
    rm -f "$CURRENT_FILE"
    show_command_menu
    echo "Logged out. No player is active now."
    echo
    echo "Create a new player or switch back with:"
    echo "  quest login YourName"
    echo "Example:"
    echo "  quest login alex"
    ;;
  who|whoami-player)
    show_command_menu
    if load_user; then
      echo "Player: $PLAYER_NAME"
      echo "Lab:    $LAB"
      echo "Quest:  $(get_quest) — $(title "$(get_quest)")"
      echo "Done:   $(done_count)/${#ORDER[@]}"
    else
      echo "No player logged in."
      echo "Run: quest login YourName"
    fi
    ;;
  users|players)
    show_command_menu
    list_users
    ;;
  status|"")
    # Always show the command structure when entering quest
    if ! load_user; then
      show_command_menu
    fi
    require_user
    show_status
    ;;
  hint|teach|lesson)
    require_user
    q="$(active_lesson)"
    hr
    echo "Player: $PLAYER_NAME"
    echo "LESSON $(level_number "$q"): $(title "$q")"
    hr
    teach "$q"
    hr
    ;;
  levels|map|list)
    require_user
    list_levels
    ;;
  go|jump)
    require_user
    shift
    jump_to_level "${1:-}"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  log)
    require_user
    shift
    echo "$*" >> "$LOG"
    echo "Logged evidence for $PLAYER_NAME: $*"
    echo "Now run: quest check"
    ;;
  check)
    require_user
    q="$(active_lesson)"
    campaign="$(get_quest)"
    echo "Player:  $PLAYER_NAME"
    echo "Checking lesson $(level_number "$q"): $q — $(title "$q")"
    echo

    # Replay of an already-cleared level: never undo later progress.
    if is_done "$q" && [[ "$q" != "$campaign" ]]; then
      if verify "$q"; then
        celebrate "$PLAYER_NAME" "$(title "$q") (replay)" ""
        echo "Replay OK. Cleared progress unchanged: $(done_count)/${#ORDER[@]}"
        clear_focus
        if [[ "$campaign" == "DONE" ]]; then
          echo "Campaign remains COMPLETE — all 29 levels are unlocked."
          echo "Jump to any level with:  quest <N>   (example: quest 5)"
          echo "See the map with:        quest levels"
        else
          echo "Returning you to campaign level $(level_number "$campaign") — $(title "$campaign")"
          echo "Run: quest"
        fi
      else
        echo "NOT YET — replay not verified for $PLAYER_NAME."
        echo "Practice the skill, then: quest check"
        echo "(Your later cleared levels are still safe.)"
        echo
        hr
        teach "$q"
        hr
        exit 1
      fi
      exit 0
    fi

    if [[ "$campaign" == "DONE" ]]; then
      celebrate_master "$PLAYER_NAME"
      teach DONE
      exit 0
    fi

    if verify "$q"; then
      if [[ "$q" == "s1" ]]; then
        echo "Detected: whoami, pwd, and clear. Great work."
        echo
      fi
      # Zone 2 later lessons expect workshop/ — prepare it if player used custom names.
      if [[ "$q" == "w1" ]]; then
        if [[ ! -d "$LAB/workshop/a/b/c" ]]; then
          mkdir -p "$LAB/workshop/a/b/c"
          echo "Nice deep nest. Also prepared workshop/a/b/c for the next lessons."
          echo
        fi
      fi
      cleared_title="$(title "$q")"
      mark_done "$q"
      n="$(next_of "$q")"
      set_quest "$n"
      clear_focus

      if [[ "$n" == DONE ]]; then
        celebrate "$PLAYER_NAME" "$cleared_title" "Command Master complete"
        celebrate_master "$PLAYER_NAME"
        teach DONE
      else
        next_title="level $(level_number "$n") — $(title "$n")"
        celebrate "$PLAYER_NAME" "$cleared_title" "$next_title"
        if ask_continue; then
          echo
          echo "Great — continuing to the next level..."
          echo
          show_status
        else
          echo
          echo "No problem, $PLAYER_NAME. Come back anytime."
          echo "When ready:"
          echo "  cd $LAB"
          echo "  quest"
          echo
          echo "Your campaign continues at: $next_title"
          echo "Or jump to any unlocked level:  quest <N>   (example: quest 5)"
        fi
      fi
    else
      echo "NOT YET — could not verify this lesson for $PLAYER_NAME."
      echo
      if [[ "$q" == "s1" ]]; then
        echo "Level 1 checklist:"
        if evidence 'whoami'; then echo "  [x] whoami"; else echo "  [ ] whoami   → run: whoami"; fi
        if evidence 'pwd'; then echo "  [x] pwd"; else echo "  [ ] pwd      → run: pwd"; fi
        if evidence 'clear'; then
          echo "  [x] clear"
        else
          echo "  [ ] clear"
          echo
          hr
          echo "WHY clear / Ctrl+L WAS NOT TRACKED"
          hr
          echo "Ctrl+L is a keyboard shortcut, not a typed command."
          echo "Most terminals do NOT save Ctrl+L into command history,"
          echo "so quest cannot see that you pressed it."
          echo
          echo "WHAT TO DO NOW (use this exact command):"
          echo "  clear"
          echo "  quest log clear"
          echo
          echo "Then run:"
          echo "  quest check"
          hr
        fi
        echo
        echo "If anything is still missing, paste this block:"
        echo "  quest log whoami"
        echo "  quest log pwd"
        echo "  quest log clear"
        echo "  quest check"
      elif [[ "$q" == "s3" ]]; then
        echo "Level 3 checklist:"
        if [[ -d "$LAB/shore/alpha" ]] || find "$LAB" -mindepth 2 -type d 2>/dev/null | grep -q .; then
          echo "  [x] nested folder found under $LAB"
        else
          echo "  [ ] need a NESTED folder under $LAB"
          echo
          hr
          echo "WHY IT FAILED"
          hr
          echo "Your commands were valid Linux — nothing is 'wrong' with that."
          echo "This level checks one specific skill: nested folders."
          echo
          if [[ -d "$LAB/lab" ]]; then
            echo "You made:  $LAB/lab     (one folder)"
            echo "Need also: $LAB/lab/inner  (or shore/alpha)"
            echo
            echo "Finish it your way:"
            echo "  cd $LAB"
            echo "  mkdir -p lab/inner"
            echo "  cd lab/inner"
            echo "  pwd"
            echo "  cd $LAB"
            echo "  quest check"
          else
            echo "Create any nested path, for example:"
            echo "  cd $LAB"
            echo "  mkdir -p shore/alpha"
            echo "  quest check"
          fi
          hr
        fi
      elif [[ "$q" == "w1" ]]; then
        echo "Level checklist:"
        if [[ -d "$LAB/workshop/a/b/c" ]] || find "$LAB" -mindepth 4 -type d 2>/dev/null | grep -q .; then
          echo "  [x] deep nested folder found"
        else
          echo "  [ ] need a deep nest (4+ folders), e.g. workshop/a/b/c"
          echo
          echo "Your own names are fine. Example:"
          echo "  mkdir -p lab1/office/desk/computer"
          echo "  quest check"
        fi
      elif [[ "$q" == "w2" ]]; then
        echo "Level checklist (skill = touch):"
        if evidence '\btouch\b' || find "$LAB" -type f ! -path '*/.*' 2>/dev/null | grep -q .; then
          echo "  [x] touch / files detected"
        else
          echo "  [ ] create at least one file with touch"
          echo
          echo "Any names/folders under your lab work. Example:"
          echo "  cd $LAB/lab1"
          echo "  touch notepad.txt"
          echo "  quest check"
        fi
      else
        echo "Try:"
        echo "  source ~/.bashrc"
        log_hints_for "$q"
        echo "  quest check"
      fi
      echo
      hr
      teach "$q"
      hr
      exit 1
    fi
    ;;
  reset)
    require_user
    printf '%s\n' '{"quest":"s1","done":[],"boss":[],"name":"'"$PLAYER_NAME"'"}' > "$PROG"
    : > "$LOG"
    # Wipe lab contents without deleting the directory inode (avoids getcwd errors
    # in shells that are already cd'd into the lab).
    mkdir -p "$LAB"
    find "$LAB" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
    heal_cwd "$LAB"
    echo "Progress reset for player: $PLAYER_NAME"
    echo "Lab wiped. Stay here or run: cd $LAB"
    echo
    show_status
    ;;
  *)
    if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
      require_user
      jump_to_level "$1"
    else
      echo "Unknown command: $1"
      echo
      cmd_help
      exit 1
    fi
    ;;
esac
