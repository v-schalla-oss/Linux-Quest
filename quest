#!/usr/bin/env bash
# quest — beginner-friendly Linux Command Mastery guide (terminal)
# Progress is tracked per named player.
set -euo pipefail
export LC_ALL=C LANG=C

QH="${HOME}/.quest-mastery"
USERS_DIR="${QH}/users"
CURRENT_FILE="${QH}/current_user"
ROOT_LAB="${HOME}/quest-lab"

mkdir -p "$QH" "$USERS_DIR" "$ROOT_LAB"

hr() { printf '%s\n' "----------------------------------------"; }

show_command_menu() {
  hr
  echo "QUEST COMMANDS"
  hr
  printf "%-22s %s\n" "Command" "What it does"
  hr
  printf "%-22s %s\n" "quest login Name" "create OR switch player"
  printf "%-22s %s\n" "quest new Name" "same as login (create/switch)"
  printf "%-22s %s\n" "quest" "show current lesson for that player"
  printf "%-22s %s\n" "quest <N>" "jump to unlocked level N (keeps progress)"
  printf "%-22s %s\n" "quest levels" "list all levels + cleared status"
  printf "%-22s %s\n" "quest check" "verify and advance"
  printf "%-22s %s\n" "quest who" "who is logged in"
  printf "%-22s %s\n" "quest users" "list all players + progress"
  printf "%-22s %s\n" "quest logout" "log out"
  printf "%-22s %s\n" "quest reset" "reset only current player"
  printf "%-22s %s\n" "quest help" "more help"
  hr
  echo
}

sanitize_name() {
  # Keep letters, numbers, space, dash, underscore → slug
  python3 -c "
import re,sys
n=sys.argv[1].strip()
if not n:
    raise SystemExit(1)
slug=re.sub(r'[^A-Za-z0-9._-]+', '-', n).strip('-').lower()
if not slug:
    raise SystemExit(1)
print(n)
print(slug)
" "$1"
}

# If the shell is still inside a deleted folder (common after reset),
# getcwd fails with "cannot access parent directories". Heal by cd'ing to lab.
heal_cwd() {
  local target="${1:-$HOME}"
  if ! pwd >/dev/null 2>&1; then
    mkdir -p "$target"
    cd "$target" 2>/dev/null || cd "$HOME" || true
    echo "Note: your terminal was in a deleted folder."
    echo "Fixed. You are now in: $(pwd 2>/dev/null || echo "$target")"
    echo "Next time, after a reset, run: cd $target"
    echo
  fi
}

load_user() {
  local display slug
  if [[ ! -f "$CURRENT_FILE" ]]; then
    return 1
  fi
  display="$(sed -n '1p' "$CURRENT_FILE")"
  slug="$(sed -n '2p' "$CURRENT_FILE")"
  [[ -n "$display" && -n "$slug" ]] || return 1
  PLAYER_NAME="$display"
  PLAYER_SLUG="$slug"
  PLAYER_DIR="${USERS_DIR}/${PLAYER_SLUG}"
  PROG="${PLAYER_DIR}/progress.json"
  LOG="${PLAYER_DIR}/session.log"
  LAB="${ROOT_LAB}/${PLAYER_SLUG}"
  mkdir -p "$PLAYER_DIR" "$LAB"
  touch "$LOG"
  if [[ ! -f "$PROG" ]]; then
    printf '%s\n' '{"quest":"s1","done":[],"boss":[],"name":"'"$PLAYER_NAME"'"}' > "$PROG"
  fi
  heal_cwd "$LAB"
  return 0
}

save_current_user() {
  local display="$1" slug="$2"
  printf '%s\n%s\n' "$display" "$slug" > "$CURRENT_FILE"
}

login_user() {
  local raw="$1" pair display slug prev
  # If someone types the full command as their name, recover the real name.
  # Example mistake: "quest login sushanth" → "sushanth"
  raw="$(printf '%s' "$raw" | sed -E 's/^[[:space:]]*quest[[:space:]]+(login|new|switch)[[:space:]]+//I; s/^[[:space:]]+//; s/[[:space:]]+$//')"
  if [[ -z "${raw// }" ]]; then
    echo "Name cannot be empty."
    echo
    echo "Create / switch player with:"
    echo "  quest login YourName"
    echo "Example:"
    echo "  quest login alex"
    return 1
  fi
  if [[ "$raw" == "quest" || "$raw" == "login" || "$raw" == "new" || "$raw" == "switch" ]]; then
    echo "That looks like a command, not a name."
    echo "Example:  quest login alex"
    return 1
  fi
  pair="$(sanitize_name "$raw")" || {
    echo "Please enter a valid name (use letters or numbers)."
    echo "Example:  quest login alex"
    return 1
  }
  display="$(printf '%s\n' "$pair" | sed -n '1p')"
  slug="$(printf '%s\n' "$pair" | sed -n '2p')"
  prev=""
  if [[ -f "$CURRENT_FILE" ]]; then
    prev="$(sed -n '1p' "$CURRENT_FILE")"
  fi
  save_current_user "$display" "$slug"
  local player_dir="${USERS_DIR}/${slug}"
  local is_new=0
  if [[ ! -f "${player_dir}/.started" ]]; then
    is_new=1
  fi
  load_user || {
    echo "Could not create player files for: $display"
    return 1
  }
  touch "${PLAYER_DIR}/.started"
  hr
  if [[ "$is_new" == "1" ]]; then
    echo "NEW PLAYER CREATED: $PLAYER_NAME"
    echo "Your progress will be saved under this name."
  else
    echo "Switched to existing player: $PLAYER_NAME"
  fi
  if [[ -n "$prev" && "$prev" != "$PLAYER_NAME" ]]; then
    echo "(Previously active: $prev — their progress is still saved.)"
  fi
  echo "Player folder: $LAB"
  echo "Progress file: $PROG"
  echo
  echo "To make another user later:"
  echo "  quest login OtherName"
  hr
}

ask_login_interactive() {
  echo
  hr
  echo "LINUX COMMAND MASTERY — LOGIN"
  hr
  echo "You are in the quest lab."
  echo "First step: enter your name so progress is saved for YOU."
  echo
  echo "Type ONLY your name."
  echo "  Correct:   sushanth"
  echo "  Wrong:     quest login sushanth"
  echo
  if [[ ! -t 0 ]]; then
    echo "This terminal is not interactive."
    echo "Log in with:  quest login YourName"
    exit 1
  fi
  local name
  while true; do
    printf "Your name: "
    IFS= read -r name || true
    if login_user "$name"; then
      break
    fi
  done
}

require_user() {
  if load_user; then
    return 0
  fi
  ask_login_interactive
}

get_quest() {
  python3 -c "import json;print(json.load(open(r'$PROG'))['quest'])"
}
set_quest() {
  python3 -c "import json;p=json.load(open(r'$PROG'));p['quest']='$1';p['name']='$PLAYER_NAME';json.dump(p,open(r'$PROG','w'))"
}
get_focus() {
  python3 -c "import json;print(json.load(open(r'$PROG')).get('focus') or '')"
}
set_focus() {
  local id="${1:-}"
  QUEST_FOCUS_ID="$id" QUEST_PROG="$PROG" QUEST_PNAME="$PLAYER_NAME" python3 <<'PY'
import json, os
p = json.load(open(os.environ["QUEST_PROG"]))
fid = os.environ.get("QUEST_FOCUS_ID", "")
if fid:
    p["focus"] = fid
else:
    p.pop("focus", None)
p["name"] = os.environ["QUEST_PNAME"]
json.dump(p, open(os.environ["QUEST_PROG"], "w"))
PY
}
clear_focus() { set_focus ""; }

# Lesson currently shown/checked: focus (jump) if set, else campaign quest.
active_lesson() {
  local f
  f="$(get_focus)"
  if [[ -n "$f" ]]; then
    printf '%s\n' "$f"
  else
    get_quest
  fi
}

is_done() {
  local id="$1"
  QUEST_ID="$id" QUEST_PROG="$PROG" python3 <<'PY'
import json, os, sys
p = json.load(open(os.environ["QUEST_PROG"]))
sys.exit(0 if os.environ["QUEST_ID"] in p.get("done", []) else 1)
PY
}

mark_done() {
  python3 -c "import json;p=json.load(open(r'$PROG'));d=p.setdefault('done',[]);
d.append('$1') if '$1' not in d else None;p['name']='$PLAYER_NAME';json.dump(p,open(r'$PROG','w'))"
}
done_count() {
  python3 -c "import json;print(len(json.load(open(r'$PROG')).get('done',[])))"
}

# 1-based index for a quest id (0 if unknown / DONE)
level_number() {
  local id="$1" i=0
  [[ "$id" == "DONE" ]] && { echo "${#ORDER[@]}"; return; }
  for x in "${ORDER[@]}"; do
    i=$((i + 1))
    if [[ "$x" == "$id" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo 0
}

id_at_level() {
  local n="$1"
  if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#ORDER[@]} )); then
    echo "${ORDER[$((n - 1))]}"
    return 0
  fi
  return 1
}

# Highest unlocked level number: campaign position (or all if DONE)
max_unlocked_level() {
  local q idx
  q="$(get_quest)"
  if [[ "$q" == "DONE" ]]; then
    echo "${#ORDER[@]}"
    return
  fi
  idx="$(level_number "$q")"
  if [[ "$idx" -lt 1 ]]; then
    echo 1
  else
    echo "$idx"
  fi
}

is_level_unlocked() {
  local n="$1" max
  max="$(max_unlocked_level)"
  (( n >= 1 && n <= max ))
}

list_levels() {
  local i=0 id q focus max st
  q="$(get_quest)"
  focus="$(get_focus)"
  max="$(max_unlocked_level)"
  hr
  echo "LEVEL MAP — $PLAYER_NAME"
  hr
  printf "%-4s %-8s %-22s %s\n" "#" "ID" "Title" "Status"
  hr
  for id in "${ORDER[@]}"; do
    i=$((i + 1))
    st="locked"
    if is_done "$id"; then
      st="cleared"
    elif [[ "$id" == "$q" ]]; then
      st="current"
    elif (( i <= max )); then
      st="unlocked"
    fi
    if [[ -n "$focus" && "$id" == "$focus" ]]; then
      st="$st (viewing)"
    fi
    printf "%-4s %-8s %-22s %s\n" "$i" "$id" "$(title "$id")" "$st"
  done
  hr
  echo "Cleared: $(done_count)/${#ORDER[@]}"
  if [[ "$q" == "DONE" ]]; then
    echo "Campaign: COMPLETE"
  else
    echo "Campaign: level $(level_number "$q") — $(title "$q")"
  fi
  echo
  echo "Jump without losing progress (N = any unlocked level number):"
  echo "  quest <N>     example: quest 5"
  echo "Return to campaign tip:"
  echo "  quest"
}

jump_to_level() {
  local n="$1" id max
  if [[ ! "$n" =~ ^[0-9]+$ ]]; then
    echo "Usage: quest <N>     example: quest 5"
    echo "  or:  quest go <N>"
    return 1
  fi
  if ! id="$(id_at_level "$n")"; then
    echo "Level $n does not exist. Valid: 1-${#ORDER[@]}"
    return 1
  fi
  max="$(max_unlocked_level)"
  if ! is_level_unlocked "$n"; then
    echo "Level $n is locked."
    echo "You have unlocked up to level $max."
    echo "Clear more lessons to open further levels."
    return 1
  fi
  set_focus "$id"
  echo "Jumped to level $n — $(title "$id")"
  echo "Your cleared progress is safe ($(done_count)/${#ORDER[@]} kept)."
  if is_done "$id"; then
    echo "Note: you already cleared this level (replay mode)."
  fi
  echo
  show_status
}

evidence() {
  local pat="$1"
  QUEST_LOG="$LOG" QUEST_HOME_DIR="$HOME" QUEST_PAT="$pat" python3 <<'PY'
import os, re, sys, warnings
warnings.filterwarnings("ignore", category=FutureWarning)
raw_pat = os.environ["QUEST_PAT"].lower()
# Convert common bash/POSIX class syntax into Python regex.
pat = raw_pat.replace("[[:space:]]", r"\s").replace("[[:blank:]]", r"[ \t]")
# If caller passed a plain phrase like "man ls", treat spaces loosely.
if not any(ch in pat for ch in r".*+?[](){}\^$|\\"):
    pat = r"\b" + r"\s+".join(re.escape(p) for p in pat.split()) + r"\b"
home = os.environ["QUEST_HOME_DIR"]
paths = [
    os.environ["QUEST_LOG"],
    os.path.join(home, ".quest-mastery", "session.log"),  # legacy hook path
    os.path.join(home, ".zsh_history"),
    os.path.join(home, ".bash_history"),
]
lines = []
for path in paths:
    try:
        data = open(path, "rb").read().decode("utf-8", "ignore")
    except OSError:
        continue
    for raw in data.splitlines()[-500:]:
        m = re.match(r"^:\s*\d+:\d+;(.*)$", raw)
        lines.append(m.group(1) if m else raw)
text = "\n".join(lines).lower()
sys.exit(0 if re.search(pat, text, re.M) else 1)
PY
}

