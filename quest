ask_continue() {
  # Returns 0 if user wants to continue
  if [[ ! -t 0 ]]; then
    # Non-interactive (automation): continue by default
    return 0
  fi
  local ans
  while true; do
    printf "Do you want to continue to the next level? (y/n): "
    IFS= read -r ans || ans="y"
    case "$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')" in
      y|yes|"") return 0 ;;
      n|no) return 1 ;;
      *) echo "Please type y or n." ;;
    esac
  done
}

verify() {
  local q="$1"
  case "$q" in
    # Level 1 requires whoami + pwd + clear evidence.
    # Ctrl+L often never appears in history, so players may need: quest log clear
    s1) evidence 'whoami' && evidence 'pwd' && evidence 'clear' ;;
    s2) evidence 'man ls' && evidence 'man man' ;;
    # Nested folder practice. Recommended name is shore/alpha, but any nested
    # path under the lab (depth >= 2) also counts — e.g. lab/inner, a/b.
    s3)
      [[ -d "$LAB/shore/alpha" ]] \
        || find "$LAB" -mindepth 2 -type d 2>/dev/null | grep -q . \
        || evidence 'mkdir -p .*/'
      ;;
    s4) evidence 'ls -la' || evidence 'ls -al' || evidence 'ls -l -a' ;;
    boss1) (evidence 'ls -la' || evidence 'ls -al') && evidence 'whoami' && evidence 'pwd' ;;
    # Deep nest (4+ levels). Recommended: workshop/a/b/c — custom names OK too.
    w1)
      [[ -d "$LAB/workshop/a/b/c" ]] \
        || find "$LAB" -mindepth 4 -type d 2>/dev/null | grep -q .
      ;;
    # Skill is touch — any new file(s) under the lab (or evidence of touch) count.
    # workshop/ is only a suggested sandbox, not required.
    w2)
      evidence '\btouch\b' \
        || find "$LAB" -type f ! -path '*/.*' 2>/dev/null | grep -q .
      ;;
    # Skill is mv + cp — filenames can be whatever the player chose.
    w3) evidence '\bmv\b' && evidence '\bcp\b' ;;
    w4) evidence '\brm\b' || evidence 'rmdir' ;;
    boss2) [[ -d "$LAB/greenhouse/winter" ]] || evidence 'greenhouse' ;;
    t1) evidence '\bhead\b' && evidence '\btail\b' ;;
    t2) [[ -f "$LAB/log.txt" ]] || evidence '>>' ;;
    t3) evidence 'uniq' && evidence 'sort' ;;
    t4) ls "$LAB"/day*.txt >/dev/null 2>&1 || evidence 'day\{1' ;;
    boss3) evidence 'uniq' || [[ -f "$LAB/ranked.txt" ]] ;;
    h1) evidence '\bfind\b' ;;
    h2) evidence '\bgrep\b' ;;
    h3) evidence '\bdiff\b' ;;
    h4) evidence '\bdu\b' || evidence '\bhistory\b' ;;
    boss4) evidence '\bfind\b' && evidence '\bgrep\b' ;;
    e1) evidence '\bps\b' || evidence '\btop\b' ;;
    e2) evidence '\bkill\b' ;;
    e3) evidence '\bjobs\b' || evidence 'sleep' ;;
    boss5) evidence '\bjobs\b' && evidence '\bkill\b' ;;
    k1) evidence '\btar\b' || ls "$LAB"/*.tgz >/dev/null 2>&1 ;;
    k2) evidence '\bnano\b' || [[ -f "$LAB/keep/readme.txt" ]] ;;
    k3) evidence '\balias\b' || evidence 'xargs' ;;
    k4) evidence 'chmod' || evidence 'ln -s' ;;
    # Final boss needs a NEW backup archive (not the earlier docs.tgz from k1).
    boss6)
      find "$LAB" -maxdepth 2 \( -name '*backup*.tgz' -o -name '*backup*.tar.gz' \) 2>/dev/null | grep -q .
      ;;
    *) return 1 ;;
  esac
}

next_of() {
  local cur="$1" i
  for i in "${!ORDER[@]}"; do
    if [[ "${ORDER[$i]}" == "$cur" ]]; then
      local j=$((i+1))
      (( j < ${#ORDER[@]} )) && { echo "${ORDER[$j]}"; return; }
      echo DONE; return
    fi
  done
  echo s1
}

ensure_logger_hint() {
  if ! grep -q 'quest-mastery-hook' "$HOME/.bashrc" 2>/dev/null; then
    cat >> "$HOME/.bashrc" <<'EOF'

# quest-mastery-hook
_quest_log_last_command() {
  local cmd
  cmd=$(history 1 2>/dev/null | sed 's/^ *[0-9]* *//')
  [[ -n "$cmd" ]] || return 0
  case "$cmd" in
    quest*|\#*) return 0 ;;
  esac
  mkdir -p "$HOME/.quest-mastery"
  # Prefer current player's log if logged in
  if [[ -f "$HOME/.quest-mastery/current_user" ]]; then
    slug=$(sed -n '2p' "$HOME/.quest-mastery/current_user")
    logfile="$HOME/.quest-mastery/users/$slug/session.log"
  else
    logfile="$HOME/.quest-mastery/session.log"
  fi
  mkdir -p "$(dirname "$logfile")"
  printf '%s\n' "$cmd" >> "$logfile"
}
PROMPT_COMMAND="_quest_log_last_command${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
EOF
  fi
  if [[ "${PROMPT_COMMAND:-}" != *_quest_log_last_command* ]]; then
    echo "FIRST-TIME SETUP (important):"
    echo "  Run once so quest can see your commands:"
    echo "    source ~/.bashrc"
    echo
  fi
}

log_hints_for() {
  case "$1" in
    s1) echo "  quest log whoami"; echo "  quest log pwd"; echo "  quest log clear" ;;
    s2) echo "  quest log man ls"; echo "  quest log man man" ;;
    s4) echo "  quest log ls -la" ;;
    boss1) echo "  quest log ls -la"; echo "  quest log whoami"; echo "  quest log pwd" ;;
    *) echo "  quest log <command-you-ran>" ;;
  esac
}

list_users() {
  hr
  echo "PLAYERS"
  hr
  if [[ -z "$(ls -A "$USERS_DIR" 2>/dev/null || true)" ]]; then
    echo "(none yet)"
    echo
    echo "Start with: quest login YourName"
    return
  fi
  python3 - <<PY
import json, os
root="$USERS_DIR"
cur_file="$CURRENT_FILE"
cur=None
if os.path.isfile(cur_file):
    lines=open(cur_file).read().splitlines()
    cur=lines[1] if len(lines)>1 else None
print(f"{'Active':<8}{'Name':<20}{'Quest':<10}{'Done':<8}{'Folder'}")
for slug in sorted(os.listdir(root)):
    d=os.path.join(root, slug)
    prog=os.path.join(d, "progress.json")
    if not os.path.isfile(prog):
        continue
    p=json.load(open(prog))
    name=p.get("name", slug)
    quest=p.get("quest", "?")
    done=len(p.get("done", []))
    mark="->" if slug==cur else ""
    print(f"{mark:<8}{name:<20}{quest:<10}{done:<8}{d}")
PY
}

